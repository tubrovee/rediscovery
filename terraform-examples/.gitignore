# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude override files as they are usually local only
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# terraform.tfvars files often contain sensitive data
terraform.tfvars
*.auto.tfvars

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Provider plugin cache (if configured)
.terraform.d/plugin-cache/